library(readr)
library(AER)
# load data
df <- read_csv("ang_ev_1980.csv")
# part 1: linear regression of outcome and treatment on samesex instrument
# regress morekids on samsex instrument (first stage)
morekids_model <- lm(morekids ~ samesex, data = df)
summary(morekids_model)
# regress mom_worked on samesex instrument
mom_worked_model <- lm(mom_worked ~ samesex, data=df)
summary(mom_worked_model)
# regress mom_weeks_worked on samesex instrument
mom_weeks_worked_model <- lm(mom_weeks_worked ~ samesex, data=df)
summary(mom_weeks_worked_model)
iv_mom_worked_model <- ivreg(mom_worked ~ morekids | samesex, data=df)
summary(iv_mom_worked_model)
# mom_weeks_worked outcome
iv_mom_weeks_worked_model <- ivreg(mom_weeks_worked ~ morekids | samesex, data=df)
summary(iv_mom_weeks_worked_model)
# Load necessary libraries
library(AER)  # for ivreg()
library(dplyr)  # for basic data manipulation (optional)
library(readr)  # for read_csv()
# Load the data
data <- read_csv("ang_ev_1980.csv")
# PART (a) ---------------------------------------------------------
# Run a linear regression of outcome and treatment on samesex instrument
# Regression of mom_worked on samesex (reduced form for mom_worked)
lm_mom_worked <- lm(mom_worked ~ samesex, data = data)
summary(lm_mom_worked)
# Regression of mom_weeks_worked on samesex (reduced form for mom_weeks_worked)
lm_mom_weeks_worked <- lm(mom_weeks_worked ~ samesex, data = data)
summary(lm_mom_weeks_worked)
# Regression of morekids on samesex (first stage)
lm_morekids <- lm(morekids ~ samesex, data = data)
summary(lm_morekids)
# PART (b) ---------------------------------------------------------
# IV regression of outcome on morekids using samesex as instrument
# mom_worked outcome
iv_mom_worked <- ivreg(mom_worked ~ morekids | samesex, data = data)
summary(iv_mom_worked)
# mom_weeks_worked outcome
iv_mom_weeks_worked <- ivreg(mom_weeks_worked ~ morekids | samesex, data = data)
summary(iv_mom_weeks_worked)
# PART (c) ---------------------------------------------------------
# Compute Wald estimates using the coefficients from Part (a)
# Extract the slopes (coefficients on samesex) from the regressions in Part (a)
coef_mom_worked <- coef(lm_mom_worked)[2]
coef_mom_weeks_worked <- coef(lm_mom_weeks_worked)[2]
coef_morekids <- coef(lm_morekids)[2]
# Wald estimators
wald_mom_worked <- coef_mom_worked / coef_morekids
wald_mom_weeks_worked <- coef_mom_weeks_worked / coef_morekids
# Display Wald estimates
wald_mom_worked
wald_mom_weeks_worked
# mom_worked model
iv2_mom_worked_model <- ivreg(mom_worked ~ morekids | samesex + twins_2, data=df)
summary(iv2_mom_worked_model)
# mom_weeks_worked model
iv2_mom_weeks_worked_model <- ivreg(mom_weeks_worked ~ morekids | samesex + twins_2, data=df)
summary(iv2_mom_weeks_worked_model)
first_stage_model <- lm(morekids ~ samesex + twins_2, data=df)
df$morekids_hat <- predict(first_stage_model)
ss_mom_worked_model <- lm(mom_worked ~ morekids_hat, data=df)
ss_mom_weeks_worked_model <- lm(mom_weeks_worked ~ morekids_hat, data=df)
summary(iv2_mom_worked_model)
summary(ss_mom_worked_model)
summary(iv2_mom_weeks_worked_model)
summary(ss_mom_weeks_worked_model)
